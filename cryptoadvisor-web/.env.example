VITE_APP_TITLE=CryptoAdvisor Web
VITE_MOCK_DELAY_MS=150

# Sprint 4 — CMS integration.
# Set VITE_CMS_URL at build time to enable live CMS calls.
# When unset, the frontend falls back to the in-memory mock layer.
# In docker-compose, the web build arg uses this same value.
VITE_CMS_URL=http://localhost:3001

# CMS-only — Payload session secret (rotate in production)
PAYLOAD_SECRET=change-me-in-dev
